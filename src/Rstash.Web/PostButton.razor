@* A minimal antiforgery-protected POST button carrying a single id field. *@
<form action="@Action" method="post" class="rs-action-form">
    <AntiforgeryToken />
    <input type="hidden" name="id" value="@Id" />
    <button type="submit" class="rs-action @(Danger ? "rs-action-danger" : "")">@Label</button>
</form>

@code {
    [Parameter] public string Action { get; set; } = "";
    [Parameter] public long Id { get; set; }
    [Parameter] public string Label { get; set; } = "";

    /// <summary>Render as a destructive (red) action — e.g. delete.</summary>
    [Parameter] public bool Danger { get; set; }
}
