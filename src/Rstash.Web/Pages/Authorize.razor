@page "/oauth/authorize"
@layout FocusLayout
@inject SettingsService Settings
@inject NavigationManager Navigation

<PageTitle>Authorize access · @Settings.Current.SiteName</PageTitle>

<div class="rs-auth">
    @if (_error is not null)
    {
        <div class="rs-auth-card">
            <div class="rs-auth-head">
                <img src="/favicon.svg" class="rs-auth-logo" alt="" />
                <h1>Authorization error</h1>
            </div>
            <div class="rs-auth-error">@_error</div>
            <div class="rs-auth-foot"><a href="/">Return home</a></div>
        </div>
    }
    else
    {
        <div class="rs-auth-card rs-consent">
            <div class="rs-auth-head">
                <img src="/favicon.svg" class="rs-auth-logo" alt="" />
                <h1>Authorize access</h1>
                <p>An application is requesting access to your storage.</p>
            </div>

            <div class="rs-consent-app">
                <div class="rs-consent-app-host">@_host</div>
                <div class="rs-consent-app-origin">@_origin</div>
            </div>

            <div class="rs-consent-as">
                <span class="rs-avatar">@_initial</span>
                <span>Signed in as <strong>@_username</strong></span>
            </div>

            @if (_hasRoot)
            {
                <div class="rs-consent-warn">
                    This application is requesting <strong>full access</strong> to all your data.
                    Only continue if you trust it.
                </div>
            }

            <div class="rs-consent-perms">
                <div class="rs-consent-label">Permissions requested</div>
                <ul class="rs-scope-list">
                    @foreach (var scope in _scopes)
                    {
                        var (module, isWrite) = ScopeParts(scope);
                        <li class="rs-scope-row">
                            <span class="rs-scope-badges">
                                <span class="rs-scope-badge read">Read</span>
                                @if (isWrite)
                                {
                                    <span class="rs-scope-badge write">Write</span>
                                }
                            </span>
                            <span class="rs-scope-module">@module</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="rs-consent-redirect">
                <div class="rs-consent-label">After you allow, you'll return to</div>
                <div class="rs-consent-redirect-dest">@RedirectUri</div>
            </div>

            <form action="/oauth/authorize/decision" method="post" class="rs-consent-form">
                <AntiforgeryToken />
                <input type="hidden" name="redirect_uri" value="@RedirectUri" />
                <input type="hidden" name="state" value="@State" />
                <input type="hidden" name="response_type" value="@ResponseType" />
                @foreach (var scope in _scopes)
                {
                    <input type="hidden" name="scope" value="@scope" />
                }
                <input type="hidden" name="code_challenge" value="@CodeChallenge" />
                <input type="hidden" name="code_challenge_method" value="@CodeChallengeMethod" />

                <div class="rs-consent-actions">
                    <button type="submit" name="action" value="deny" class="rs-consent-deny">Deny</button>
                    <button type="submit" name="action" value="approve" class="rs-consent-allow">Allow access</button>
                </div>
            </form>

            <p class="rs-consent-note">
                Only authorize applications you trust — this application is not affiliated with @Settings.Current.SiteName.
            </p>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "response_type")] public string? ResponseType { get; set; }
    [SupplyParameterFromQuery(Name = "redirect_uri")] public string? RedirectUri { get; set; }
    [SupplyParameterFromQuery(Name = "scope")] public string? ScopeParam { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    [SupplyParameterFromQuery(Name = "code_challenge")] public string? CodeChallenge { get; set; }
    [SupplyParameterFromQuery(Name = "code_challenge_method")] public string? CodeChallengeMethod { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? _error;
    private string _origin = "";
    private string _host = "";
    private string _username = "";
    private string _initial = "?";
    private bool _hasRoot;
    private IReadOnlyList<string> _scopes = [];

    protected override void OnInitialized()
    {
        if (ResponseType is not ("token" or "code"))
        {
            _error = "The response_type parameter must be \"token\" or \"code\".";
            return;
        }

        if (string.IsNullOrEmpty(RedirectUri)
            || !Uri.TryCreate(RedirectUri, UriKind.Absolute, out var redirect)
            || string.IsNullOrEmpty(redirect.Host))
        {
            _error = "The redirect URI provided by the application is not valid.";
            return;
        }

        _origin = $"{redirect.Scheme}://{redirect.Authority}";
        _host = redirect.Host;

        if (!Scope.TryParse(ScopeParam ?? "", out var scopes))
        {
            _error = "The application requested an invalid scope (expected \"module:r\" or \"module:rw\").";
            return;
        }

        _scopes = scopes;
        _hasRoot = scopes.Any(s => s.StartsWith('*'));

        if (ResponseType == "code" && (string.IsNullOrEmpty(CodeChallenge) || CodeChallengeMethod != "S256"))
        {
            _error = "The code flow requires a code_challenge with method S256.";
            return;
        }

        // Consent requires an authenticated user.
        if (HttpContext?.User.Identity?.IsAuthenticated != true)
        {
            var returnUrl = "/oauth/authorize" + (HttpContext?.Request.QueryString.Value ?? "");
            Navigation.NavigateTo($"/login?redirect={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            return;
        }

        _username = HttpContext.User.Identity.Name ?? "";
        _initial = string.IsNullOrEmpty(_username) ? "?" : _username[..1];
    }

    // Splits "module:rw" into a display module and a write flag.
    private static (string Module, bool IsWrite) ScopeParts(string scope)
    {
        var parts = scope.Split(':', 2);
        var module = parts[0] == "*" ? "All your data" : "/" + parts[0];
        var isWrite = parts.Length > 1 && parts[1] == "rw";
        return (module, isWrite);
    }
}
