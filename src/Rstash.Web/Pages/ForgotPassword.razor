@page "/forgot-password"
@inject UserManager<ApplicationUser> Users
@inject IEmailSender Email
@inject IConfiguration Config

<PageTitle>Forgot password</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Reset your password</MudText>

@if (_message is not null)
{
    <MudAlert Severity="Severity.Info">@_message</MudAlert>
}
else
{
    <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="forgot">
        <DataAnnotationsValidator />
        <div class="mb-2"><label>Username<br /><InputText @bind-Value="Input.Username" autocomplete="username" /></label></div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success">Send reset link</MudButton>
    </EditForm>
}

@code {
    [SupplyParameterFromForm] private ForgotInput Input { get; set; } = new();

    private string? _message;

    private async Task SubmitAsync()
    {
        var user = await Users.FindByNameAsync(Input.Username);
        if (user is not null && !string.IsNullOrEmpty(user.Email))
        {
            var token = await Users.GeneratePasswordResetTokenAsync(user);
            var encoded = System.Buffers.Text.Base64Url.EncodeToString(System.Text.Encoding.UTF8.GetBytes(token));
            var baseUrl = (Config["RSTASH_BASE_URL"] ?? "http://localhost:8080").TrimEnd('/');
            var link = $"{baseUrl}/reset-password?user={Uri.EscapeDataString(user.UserName!)}&token={encoded}";

            await Email.SendAsync(new EmailMessage
            {
                To = user.Email,
                Subject = "Reset your rstash password",
                Html = $"<p>Use this link to reset your password:</p><p><a href=\"{link}\">{link}</a></p>",
                Text = link,
            });
        }

        _message = "If a matching account with an email on file exists, a reset link has been sent.";
    }

    public sealed class ForgotInput
    {
        [Required] public string Username { get; set; } = "";
    }
}
