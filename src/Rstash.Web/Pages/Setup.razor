@page "/setup"
@layout FocusLayout
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject SetupState SetupStatus
@inject SettingsService Settings
@inject IDbContextFactory<RstashDbContext> DbFactory

<PageTitle>Set up · @Settings.Current.SiteName</PageTitle>

<div class="rs-auth">
    <div class="rs-auth-card rs-setup">
        <div class="rs-auth-head">
            <img src="/favicon.svg" class="rs-auth-logo" alt="" />
            <div><span class="rs-setup-kicker">First-run setup</span></div>
            <h1>Welcome to @Settings.Current.SiteName</h1>
            <p>Create the administrator account to finish setting up your server. This is a one-time step.</p>
        </div>

        @if (_error is not null)
        {
            <div class="rs-auth-error">@_error</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="CreateAdminAsync" FormName="setup">
            <DataAnnotationsValidator />
            <div class="rs-field">
                <label class="rs-label" for="setup-username">Username</label>
                <InputText id="setup-username" class="rs-control" @bind-Value="Input.Username" autocomplete="username" />
            </div>
            <div class="rs-field">
                <label class="rs-label" for="setup-email">Email <span class="rs-optional">optional</span></label>
                <InputText id="setup-email" class="rs-control" @bind-Value="Input.Email" autocomplete="email" />
                <p class="rs-help">Used for password resets and important account notices.</p>
            </div>
            <div class="rs-field">
                <label class="rs-label" for="setup-password">Password</label>
                <InputText id="setup-password" type="password" class="rs-control"
                           @bind-Value="Input.Password" autocomplete="new-password" />
                <p class="rs-help">At least 6 characters, with upper- and lower-case letters, a number, and a symbol.</p>
            </div>
            <button type="submit" class="rs-auth-submit">Create admin account</button>
        </EditForm>

        <div class="rs-auth-foot">
            <span class="rs-setup-reassure">
                This account gets full administrative access. You can add more users once setup is complete.
            </span>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private SetupInput Input { get; set; } = new();

    private string? _error;

    private async Task CreateAdminAsync()
    {
        // Second lock on the same door as the middleware guard. This handler is what
        // actually mints an administrator, so it does not get to assume something
        // upstream vetted the request — and unlike the cached flag, this reads the
        // table, which also settles two first-run submissions racing each other.
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            if (await db.Users.AnyAsync())
            {
                SetupStatus.MarkComplete();
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }
        }

        var user = new ApplicationUser
        {
            UserName = Input.Username,
            Email = string.IsNullOrWhiteSpace(Input.Email) ? null : Input.Email,
            IsAdmin = true,
            Approved = true,
            CreatedAt = DateTimeOffset.UtcNow,

            // Stamped at creation rather than read from settings on every check, so
            // raising the default later does not silently re-quota existing accounts.
            StorageQuota = Math.Max(0, Settings.Current.DefaultUserStorageLimit),
            EgressQuota = Math.Max(0, Settings.Current.DefaultUserEgressLimit),
        };

        var result = await UserManager.CreateAsync(user, Input.Password);
        if (!result.Succeeded)
        {
            _error = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        SetupStatus.MarkComplete();
        await SignInManager.SignInAsync(user, isPersistent: true);
        Navigation.NavigateTo("/", forceLoad: true);
    }

    public sealed class SetupInput
    {
        [Required]
        public string Username { get; set; } = "";

        [EmailAddress]
        public string? Email { get; set; }

        [Required]
        public string Password { get; set; } = "";
    }
}
