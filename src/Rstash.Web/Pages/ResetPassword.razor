@page "/reset-password"
@inject UserManager<ApplicationUser> Users

<PageTitle>Reset password</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Set a new password</MudText>

@if (_message is not null)
{
    <MudAlert Severity="Severity.Success">@_message <MudLink Href="/login">Sign in</MudLink></MudAlert>
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-2">@_error</MudAlert>
    }
    <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="reset">
        <DataAnnotationsValidator />
        <div class="mb-2"><label>New password<br /><InputText type="password" @bind-Value="Input.Password" autocomplete="new-password" /></label></div>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success">Reset password</MudButton>
    </EditForm>
}

@code {
    // Round-trips on POST because the SSR form posts back to the current URL (query intact).
    [SupplyParameterFromQuery] public string? User { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromForm] private ResetInput Input { get; set; } = new();

    private string? _message;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrEmpty(User) || string.IsNullOrEmpty(Token))
        {
            _error = "This reset link is invalid or incomplete.";
            return;
        }

        var user = await Users.FindByNameAsync(User);
        if (user is null)
        {
            _error = "This reset link is invalid.";
            return;
        }

        string token;
        try
        {
            token = System.Text.Encoding.UTF8.GetString(System.Buffers.Text.Base64Url.DecodeFromChars(Token));
        }
        catch (FormatException)
        {
            _error = "This reset link is invalid.";
            return;
        }

        var result = await Users.ResetPasswordAsync(user, token, Input.Password);
        if (result.Succeeded)
        {
            _message = "Your password has been reset.";
        }
        else
        {
            _error = string.Join(" ", result.Errors.Select(e => e.Description));
        }
    }

    public sealed class ResetInput
    {
        [Required] public string Password { get; set; } = "";
    }
}
