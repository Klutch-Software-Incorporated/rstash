@page "/login"
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject SettingsService Settings
@inject NavigationManager Navigation

<PageTitle>Sign in · @Settings.Current.SiteName</PageTitle>

<div class="rs-auth">
    <div class="rs-auth-card">
        <div class="rs-auth-head">
            <img src="/favicon.svg" class="rs-auth-logo" alt="" />
            <h1>Sign in</h1>
            <p>Access your @Settings.Current.SiteName storage.</p>
        </div>

        @if (_error is not null)
        {
            <div class="rs-auth-error">@_error</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login">
            <DataAnnotationsValidator />
            <div class="rs-field">
                <label class="rs-label" for="login-username">Username</label>
                <InputText id="login-username" class="rs-control" @bind-Value="Input.Username" autocomplete="username" />
            </div>
            <div class="rs-field">
                <label class="rs-label" for="login-password">Password</label>
                <InputText id="login-password" type="password" class="rs-control"
                           @bind-Value="Input.Password" autocomplete="current-password" />
            </div>
            <button type="submit" class="rs-auth-submit">Sign in</button>
        </EditForm>

        <div class="rs-auth-foot">
            <a href="/forgot-password">Forgot your password?</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = new();

    private string? _error;

    private const string InvalidCredentials = "Invalid username or password.";

    /// <remarks>
    /// Nothing about an account is disclosed until the password proves the caller
    /// owns it. Reporting standing first made "does this user exist?" a free
    /// question: any password at all — no correct guess, no lockout — surfaced
    /// "disabled" or "pending approval" for real accounts and the generic refusal
    /// for everything else.
    /// <para>
    /// Hence CheckPasswordSignInAsync rather than PasswordSignInAsync: it verifies
    /// the password without issuing a cookie, so an account that fails the standing
    /// checks below is never signed in on the way to being told it can't be.
    /// </para>
    /// </remarks>
    private async Task SignInAsync()
    {
        var user = await UserManager.FindByNameAsync(Input.Username);
        if (user is null)
        {
            _error = InvalidCredentials;
            return;
        }

        var result = await SignInManager.CheckPasswordSignInAsync(
            user, Input.Password, lockoutOnFailure: true);

        // Deliberately still specific: extracting this costs five failed attempts,
        // and hiding it would leave someone whose correct password suddenly stopped
        // working with no idea why.
        if (result.IsLockedOut)
        {
            _error = "Too many failed attempts. This account is locked for a few minutes.";
            return;
        }

        if (!result.Succeeded)
        {
            _error = InvalidCredentials;
            return;
        }

        if (user.Disabled)
        {
            _error = "This account is disabled.";
            return;
        }

        if (!user.Approved)
        {
            _error = "This account is pending approval.";
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: true);

        // Honor a local return URL (e.g. from /oauth/authorize); never off-site.
        var target = ReturnUrl is { Length: > 0 } url && url.StartsWith('/') ? url : "/";
        Navigation.NavigateTo(target, forceLoad: true);
    }

    [SupplyParameterFromQuery(Name = "redirect")]
    private string? ReturnUrl { get; set; }

    public sealed class LoginInput
    {
        [Required]
        public string Username { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}
