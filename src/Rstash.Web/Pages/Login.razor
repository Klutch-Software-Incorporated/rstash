@page "/login"
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Sign in</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label>Username<br /><InputText @bind-Value="Input.Username" autocomplete="username" /></label>
    </div>
    <div class="mb-3">
        <label>Password<br /><InputText type="password" @bind-Value="Input.Password" autocomplete="current-password" /></label>
    </div>
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success">
        Sign in
    </MudButton>
</EditForm>

<MudText Class="mt-3"><MudLink Href="/forgot-password">Forgot your password?</MudLink></MudText>

@code {
    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = new();

    private string? _error;

    private async Task SignInAsync()
    {
        var user = await UserManager.FindByNameAsync(Input.Username);
        if (user is null)
        {
            _error = "Invalid username or password.";
            return;
        }

        if (user.Disabled)
        {
            _error = "This account is disabled.";
            return;
        }

        if (!user.Approved)
        {
            _error = "This account is pending approval.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            user, Input.Password, isPersistent: true, lockoutOnFailure: false);

        if (!result.Succeeded)
        {
            _error = "Invalid username or password.";
            return;
        }

        // Honor a local return URL (e.g. from /oauth/authorize); never off-site.
        var target = ReturnUrl is { Length: > 0 } url && url.StartsWith('/') ? url : "/";
        Navigation.NavigateTo(target, forceLoad: true);
    }

    [SupplyParameterFromQuery(Name = "redirect")]
    private string? ReturnUrl { get; set; }

    public sealed class LoginInput
    {
        [Required]
        public string Username { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";
    }
}
