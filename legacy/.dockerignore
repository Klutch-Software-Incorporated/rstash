# Keep the build context lean so Docker pushes don't upload our entire
# working directory to the builder.

# VCS
.git
.gitignore
.gitattributes

# Go build output — produced inside the container
dist
*.exe
rstash
rstash-*

# SQLite runtime files
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Node build artifacts
site/node_modules
site/dist
node_modules

# Editor / IDE
.vscode
.idea
.claude
.devcontainer

# OS cruft
.DS_Store
Thumbs.db

# Pipeline definitions aren't needed in the image
azure-pipelines*.yml

# Local docs / scratch
TODO.md
.env
.env.local
