---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const docs = (await getCollection("docs")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<Base title="Documentation — rstash">
  <div class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-2">Documentation</h1>
    <p class="mb-8" style="color: var(--color-text-muted);">
      Everything you need to set up and run rstash.
    </p>
    <div class="space-y-4">
      {docs.map((doc) => (
        <a
          href={`/docs/${doc.id}/`}
          class="block rounded-lg border p-5 transition-colors"
          style={`border-color: var(--color-border); background: var(--color-surface);`}
        >
          <h2 class="font-semibold mb-1">{doc.data.title}</h2>
          {doc.data.description && (
            <p class="text-sm" style="color: var(--color-text-muted);">
              {doc.data.description}
            </p>
          )}
        </a>
      ))}
    </div>
  </div>
</Base>
