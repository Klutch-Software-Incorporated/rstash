@page "/files"
@page "/files/{**Path}"
@attribute [Authorize]
@inject RemoteStorageService Storage
@inject UserManager<ApplicationUser> Users

<PageTitle>Files</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Files</MudText>

<MudBreadcrumbs Items="_crumbs" Class="px-0 mb-3" />

<MudSimpleTable Hover="true" Elevation="1" Class="rs-files-table">
    <thead>
        <tr>
            <th>Name</th>
            <th class="rs-files-size">Size</th>
            <th>Type</th>
            <th class="rs-files-actions">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (_folderPath != "/")
        {
            <tr>
                <td colspan="4">
                    <a href="@ParentUrl" class="rs-files-name">
                        <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" Size="Size.Small" />../
                    </a>
                </td>
            </tr>
        }
        @foreach (var item in _items)
        {
            <tr>
                <td>
                    @if (item.IsFolder)
                    {
                        <a href="@($"/files/{_relativePath}{item.Name}")" class="rs-files-name">
                            <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" Size="Size.Small" />@item.Name
                        </a>
                    }
                    else
                    {
                        <a href="@($"/files/download/{_relativePath}{item.Name}")" class="rs-files-name">
                            <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />@item.Name
                        </a>
                    }
                </td>
                <td class="rs-files-size rs-mono">@(item.IsFolder ? "" : Format(item.Size))</td>
                <td class="rs-mono">@(item.IsFolder ? "folder" : item.Type)</td>
                <td class="rs-files-actions">
                    @if (!item.IsFolder)
                    {
                        <form method="post" action="/files/delete">
                            <AntiforgeryToken />
                            <input type="hidden" name="path" value="@($"{_folderPath}{item.Name}")" />
                            <input type="hidden" name="folder" value="@_folderPath" />
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text"
                                       Color="Color.Error" Size="Size.Small">Delete</MudButton>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (_items.Count == 0)
        {
            <tr><td colspan="4" class="rs-empty">This folder is empty.</td></tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    [Parameter] public string? Path { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string _relativePath = "";   // e.g. "documents/"
    private string _folderPath = "/";    // e.g. "/documents/"
    private List<FileRow> _items = [];
    private List<BreadcrumbItem> _crumbs = [];

    protected override async Task OnInitializedAsync()
    {
        _relativePath = string.IsNullOrEmpty(Path) ? "" : (Path.EndsWith('/') ? Path : Path + "/");
        _folderPath = "/" + _relativePath;
        BuildCrumbs();

        var user = HttpContext is null ? null : await Users.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            return;
        }

        var (description, _) = await Storage.GetFolderAsync(user.Id, _folderPath, new StorageConditions());
        _items = description.Items
            .Select(entry => new FileRow(
                entry.Key, entry.Key.EndsWith('/'), entry.Value.ContentLength ?? 0, entry.Value.ContentType ?? ""))
            .OrderByDescending(row => row.IsFolder)
            .ThenBy(row => row.Name, StringComparer.Ordinal)
            .ToList();
    }

    private void BuildCrumbs()
    {
        _crumbs = [new BreadcrumbItem("Home", "/files")];
        var accumulated = "";
        var segments = _relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < segments.Length; i++)
        {
            accumulated += segments[i] + "/";
            _crumbs.Add(new BreadcrumbItem(segments[i], "/files/" + accumulated, disabled: i == segments.Length - 1));
        }
    }

    private string ParentUrl
    {
        get
        {
            var trimmed = _folderPath.TrimEnd('/');
            var lastSlash = trimmed.LastIndexOf('/');
            var parent = lastSlash <= 0 ? "" : trimmed[1..lastSlash] + "/";
            return "/files/" + parent;
        }
    }

    private static string Format(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return unit == 0 ? $"{bytes} B" : $"{size:0.#} {units[unit]}";
    }

    private sealed record FileRow(string Name, bool IsFolder, long Size, string Type);
}
