@inherits LayoutComponentBase
@inject Rstash.Services.SettingsService Settings
@inject UserManager<ApplicationUser> Users
@inject NavigationManager Navigation

<MudThemeProvider Theme="RstashTheme.Theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="rs-shaper" aria-hidden="true">
    <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M180 0 Q140 150 180 300 T180 600 T180 900 T180 1000 H0 V0Z" class="rs-wave-a" />
        <path d="M140 0 Q110 120 140 250 T130 500 T150 750 T140 1000 H0 V0Z" class="rs-wave-b" />
        <path d="M100 0 Q70 200 100 400 T110 800 T100 1000 H0 V0Z" class="rs-wave-c" />
    </svg>
</div>

<MudLayout>
    <MudAppBar Elevation="0" Class="rs-appbar">
        <a href="/" class="rs-brand"><img src="/favicon.svg" class="rs-brand-logo" alt="" />@_siteName</a>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudButton Href="/" Color="@NavColor(IsActive("/", exact: true))" Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.Dashboard" Class="mx-1">Dashboard</MudButton>
                <MudButton Href="/files" Color="@NavColor(IsActive("/files"))" Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.Folder" Class="mx-1">Files</MudButton>
                @if (_isAdmin)
                {
                    <MudButton Href="/admin/settings" Color="@NavColor(IsActive("/admin"))" Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.AdminPanelSettings" Class="mx-1">Admin</MudButton>
                }
                <a href="/account" class="rs-account mx-2">
                    <span>@_accountLabel</span>
                    <span class="rs-avatar">@_initial</span>
                </a>
                <form action="/auth/logout" method="post" class="d-flex">
                    <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout"
                                   Color="Color.Inherit" title="Sign out" />
                </form>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="rs-main mt-6 mb-4">
            @Body
        </MudContainer>
        <MudContainer MaxWidth="MaxWidth.False" Class="rs-main">
            <footer class="rs-footer">
                <span class="rs-mono">@_siteName</span>
                <span>Open source · self-hosted</span>
                <a href="/files">Files</a>
                <a href="/account">Account</a>
            </footer>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private bool _isDarkMode;
    private bool _isAdmin;
    private string _siteName = "rstash";
    private string _accountLabel = "";
    private string _initial = "?";
    private string _path = "/";

    protected override async Task OnInitializedAsync()
    {
        _siteName = Settings.Current.SiteName;
        _path = new Uri(Navigation.Uri).AbsolutePath;

        if (HttpContext is null)
        {
            return;
        }

        // Dark mode is not user-toggleable yet (planned as an account setting); we still
        // honor the cookie so that future setting can drive it without a layout change.
        _isDarkMode = HttpContext.Request.Cookies.TryGetValue(RstashTheme.ThemeCookie, out var pref)
            && string.Equals(pref, "dark", StringComparison.OrdinalIgnoreCase);

        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            var user = await Users.GetUserAsync(HttpContext.User);
            _isAdmin = user?.IsAdmin ?? false;

            // Show the remoteStorage handle (user@host) — the brand's identity anchor.
            var name = user?.UserName ?? HttpContext.User.Identity.Name ?? "";
            var host = new Uri(Navigation.BaseUri).Host;
            _accountLabel = string.IsNullOrEmpty(name) ? host : $"{name}@{host}";
            _initial = string.IsNullOrEmpty(name) ? "?" : name[..1];
        }
    }

    // Highlight the nav entry for the active page in the brand gold.
    private bool IsActive(string prefix, bool exact = false) =>
        exact ? _path == prefix : _path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);

    private static Color NavColor(bool active) => active ? Color.Secondary : Color.Inherit;
}
