@page "/account"
@attribute [Authorize]
@inject UserManager<ApplicationUser> Users
@inject SignInManager<ApplicationUser> SignInManager

<PageTitle>Account</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Account</MudText>

<MudPaper Class="rs-card mb-4" Elevation="1">
    <div class="rs-card-head"><h2>Profile</h2></div>
    <div class="rs-settings-body">
        <dl class="rs-deflist">
            <dt>Username</dt>
            <dd class="rs-mono">@_username</dd>
            <dt>Role</dt>
            <dd>
                @if (_isAdmin)
                {
                    <span class="rs-badge-mod">Admin</span>
                }
                else
                {
                    <text>User</text>
                }
            </dd>
            <dt>Email</dt>
            <dd>@(_email ?? "—")</dd>
            <dt>Member since</dt>
            <dd>@_memberSince</dd>
        </dl>
    </div>
</MudPaper>

<div class="rs-form-grid mb-4">
    <MudPaper Class="rs-card" Elevation="1">
        <div class="rs-card-head"><h2>Change password</h2></div>
        <div class="rs-settings-body">
            @if (_passwordMessage is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">@_passwordMessage</MudAlert>
            }
            @if (_passwordError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_passwordError</MudAlert>
            }
            <EditForm Model="PasswordModel" method="post" OnValidSubmit="ChangePasswordAsync" FormName="password">
                <DataAnnotationsValidator />
                <div class="rs-field">
                    <label class="rs-label" for="current-password">Current password</label>
                    <InputText id="current-password" type="password" class="rs-control"
                               @bind-Value="PasswordModel.Current" autocomplete="current-password" />
                </div>
                <div class="rs-field">
                    <label class="rs-label" for="new-password">New password</label>
                    <InputText id="new-password" type="password" class="rs-control"
                               @bind-Value="PasswordModel.New" autocomplete="new-password" />
                </div>
                <div class="rs-form-actions">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                               Color="Color.Success">Update password</MudButton>
                </div>
            </EditForm>
        </div>
    </MudPaper>

    <MudPaper Class="rs-card" Elevation="1">
        <div class="rs-card-head"><h2>Change email</h2></div>
        <div class="rs-settings-body">
            @if (_emailMessage is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">@_emailMessage</MudAlert>
            }
            @if (_emailError is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_emailError</MudAlert>
            }
            <EditForm Model="EmailModel" method="post" OnValidSubmit="ChangeEmailAsync" FormName="email">
                <DataAnnotationsValidator />
                <div class="rs-field">
                    <label class="rs-label" for="email">Email address</label>
                    <InputText id="email" class="rs-control" @bind-Value="EmailModel.Email" autocomplete="email" />
                </div>
                <div class="rs-form-actions">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                               Color="Color.Success">Update email</MudButton>
                </div>
            </EditForm>
        </div>
    </MudPaper>
</div>

@code {
    [SupplyParameterFromForm(FormName = "password")] private PasswordInput PasswordModel { get; set; } = new();
    [SupplyParameterFromForm(FormName = "email")] private EmailInput EmailModel { get; set; } = new();
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string _username = "";
    private string? _email;
    private bool _isAdmin;
    private string _memberSince = "—";
    private string? _passwordMessage;
    private string? _passwordError;
    private string? _emailMessage;
    private string? _emailError;

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUserAsync();
        if (user is null)
        {
            return;
        }

        _username = user.UserName ?? "";
        _email = user.Email;
        _isAdmin = user.IsAdmin;
        _memberSince = user.CreatedAt.Year > 1 ? user.CreatedAt.ToString("MMMM d, yyyy") : "—";
    }

    private async Task ChangePasswordAsync()
    {
        var user = await CurrentUserAsync();
        if (user is null)
        {
            return;
        }

        var result = await Users.ChangePasswordAsync(user, PasswordModel.Current, PasswordModel.New);
        if (result.Succeeded)
        {
            await SignInManager.RefreshSignInAsync(user);
            _passwordMessage = "Password updated.";
            _passwordError = null;
        }
        else
        {
            _passwordError = string.Join(" ", result.Errors.Select(e => e.Description));
            _passwordMessage = null;
        }
    }

    private async Task ChangeEmailAsync()
    {
        var user = await CurrentUserAsync();
        if (user is null)
        {
            return;
        }

        var result = await Users.SetEmailAsync(user, EmailModel.Email);
        if (result.Succeeded)
        {
            _email = EmailModel.Email;
            _emailMessage = "Email updated.";
            _emailError = null;
        }
        else
        {
            _emailError = string.Join(" ", result.Errors.Select(e => e.Description));
            _emailMessage = null;
        }
    }

    private Task<ApplicationUser?> CurrentUserAsync() =>
        HttpContext is null ? Task.FromResult<ApplicationUser?>(null) : Users.GetUserAsync(HttpContext.User);

    public sealed class PasswordInput
    {
        [Required] public string Current { get; set; } = "";
        [Required] public string New { get; set; } = "";
    }

    public sealed class EmailInput
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
    }
}
