<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Form models intentionally keep initializers for the initial SSR render. -->
    <NoWarn>$(NoWarn);BL0008</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI components use ASP.NET Core types (Identity managers, etc.). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MudBlazor" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rstash.Model\Rstash.Model.csproj" />
    <ProjectReference Include="..\Rstash.Notifications\Rstash.Notifications.csproj" />
    <ProjectReference Include="..\Rstash.Services\Rstash.Services.csproj" />
  </ItemGroup>

</Project>
